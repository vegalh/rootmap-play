# Copy this file to `.env.local` for local development.
# `.env.local` is git-ignored and must never be committed.
#
# RootMap Play never requires these to run — without them the site falls
# back to a safe no-op analytics provider and the admin dashboard shows a
# "setup required" state. See docs/ARCHITECTURE.md and docs/ANALYTICS_EVENTS.md.

# Supabase project URL (public). Example: https://xxxxx.supabase.co
VITE_SUPABASE_URL=

# Supabase anonymous / publishable key (public, NOT the service-role key).
# Never put the service-role key in any VITE_ prefixed variable — anything
# prefixed with VITE_ is bundled into the public frontend JavaScript.
VITE_SUPABASE_ANON_KEY=

# Set to "true" to allow analytics events to be forwarded to Supabase once
# VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY are configured. Leave unset
# or "false" to keep analytics fully disabled (no-op provider).
VITE_ENABLE_ANALYTICS=false
